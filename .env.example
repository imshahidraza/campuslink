# Point this at your local PostgreSQL instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuslink"

# Local Ollama server + model
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:e4b"

# Used to sign the login session cookie. Production mode REFUSES to start sessions if this is
# missing, under 16 characters, or still this placeholder. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-any-random-string"

# Optional but recommended when hosted (servers often run in UTC): keeps interview times in IST.
# TZ="Asia/Kolkata"

# Optional, demo only: days before a recruiter is prompted about an unanswered offer (default 3).
# OFFER_FOLLOW_UP_DAYS="3"

# Placement-cell (TPO) signup code. TPO accounts can see all student records, so signup needs this code.
# Share it only with real placement staff. If it is NOT set, only the very first TPO can ever register.
TPO_SIGNUP_CODE="choose-a-private-code"

# Recorded video interview: the private speech-to-text service (see whisper-service/README.md).
# The website and the service read this same key. At least 24 random characters.
WHISPER_API_KEY="change-this-to-a-long-random-string"
# WHISPER_URL="http://127.0.0.1:8765"
# WHISPER_MODEL="small"
# WHISPER_DEVICE="cpu"
