generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TPO
  RECRUITER
}

/// TPO-managed catalog of specializations per program (e.g. B.Tech -> CSE, MBA -> Marketing).
/// Program is one of the fixed PROGRAM_OPTIONS in src/lib/programs.ts.
/// name is always stored uppercase to prevent case-duplicate entries.
model Specialization {
  id        String   @id @default(cuid())
  program   String
  name      String
  createdAt DateTime @default(now())

  @@unique([program, name])
}

/// Single row in practice (this build is single-college). The first TPO to
/// register creates it; every TPO after that just joins the existing one.
model College {
  id          String   @id @default(cuid())
  name        String
  emailDomain String? // e.g. "mycollege.edu" (if set, student signup emails must match it)
  // Where students are told to email their documents after accepting an offer.
  // If empty, the first TPO account's email is shown instead.
  tpoEmail    String?
  createdAt   DateTime @default(now())
}

/// A roster row the TPO enters ahead of time (bulk-pasted). A student "claims"
/// it at signup by roll number (+ email domain check), which creates their
/// real Student record from these TPO-verified values and removes this row.
model PendingStudent {
  id             String   @id @default(cuid())
  rollNo         String   @unique
  name           String
  program        String
  branch         String
  cgpa           Float
  backlogs       Int
  graduationYear Int
  // Optional assessment scores imported together with the roster; copied to the
  // Student record when the student signs up.
  aptitudeScore      Int?
  reasoningScore     Int?
  verbalScore        Int?
  communicationScore Int?
  createdAt      DateTime @default(now())
}

enum ReadinessLevel {
  NOT_READY
  DEVELOPING
  READY
  HIGHLY_READY
}

enum PlacementStatus {
  UNPLACED
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  JOINED
}

enum DriveStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ApplicationStage {
  ELIGIBLE
  SHORTLISTED
  INTERVIEW
  SELECTED
  OFFER_REQUESTED // recruiter asked the TPO to extend an offer
  OFFER_SENT // TPO forwarded it to the student — awaiting their response
  OFFER_ACCEPTED // student accepted — placed, pending joining formalities
  OFFER_DECLINED // student declined — does NOT block other drives
  JOINED // documents verified + joining confirmed
  REJECTED // shown to users as "Not selected"
  WITHDRAWN // the student withdrew their own application
}

/// What kind of offer this is. Old offers (made before this existed) default to FULL_TIME.
enum OfferType {
  INTERNSHIP
  PPO // pre-placement offer: a job offer made on the back of an internship or earlier performance
  FULL_TIME
}

/// A student's request to move the joining date of an accepted offer. The placement cell decides.
enum DeferralStatus {
  PENDING
  APPROVED
  DECLINED
}

/// Where a student on the support (escalation) list stands.
enum EscalationStatus {
  OPEN // flagged by the rules, no mentor yet
  ASSIGNED // a mentor is looking after the student
  RESOLVED
}

enum ScheduleStatus {
  WAITING_TPO // the recruiter sent preferred dates; the placement cell has to answer
  WAITING_RECRUITER // the placement cell suggested other dates; the recruiter has to answer
  CONFIRMED // both sides agreed
}

enum RecruiterStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationType {
  DRIVE_ANNOUNCEMENT
  SHORTLIST
  INTERVIEW_SCHEDULE
  DOCUMENT_DEADLINE
  OFFER_UPDATE
  SPECIAL_CONSIDERATION
  OFFER_RESPONSE
  GENERAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Optional, unverified (no OTP). Collected for TPO and Recruiter accounts so
  // they can sign in with a phone number instead of email. Stored normalized
  // (+<countrycode><number>); students sign in with their roll number instead.
  phone     String?  @unique
  password  String
  role      Role
  name      String
  createdAt DateTime @default(now())

  student   Student?
  recruiter Recruiter?
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Official / verified college data (TPO-managed)
  rollNo             String   @unique
  program            String?  // e.g. "B.Tech", "MBA" — picked from the fixed PROGRAM_OPTIONS list
  branch             String   // specialization name, e.g. "CSE" — always uppercase, sourced from the Specialization catalog
  cgpa               Float
  backlogs           Int      @default(0)
  graduationYear     Int
  aptitudeScore      Int?
  reasoningScore     Int?
  verbalScore        Int?
  communicationScore Int?
  placementStatus    PlacementStatus @default(UNPLACED)

  // Student-provided career data
  resumeText     String?
  resumeSkills   String[] @default([])
  // The uploaded PDF itself lives in its own table so normal student queries never load the bytes.
  resume         Resume?
  skills         String[] @default([])
  projects       Json?    // [{title, description, tech[]}]
  certifications String[] @default([])
  experience     Json?    // [{title, org, duration, description}]
  courses        String[] @default([])
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  preferredRoles String[] @default([])

  // AI-derived
  readinessLevel   ReadinessLevel?
  readinessSummary String?
  strengths        String[] @default([])
  skillGaps        String[] @default([])
  improvementAreas String[] @default([])
  readinessUpdatedAt DateTime?

  // On-demand AI outputs, cached so a click doesn't recompute (and a slow local model isn't hit twice)
  roadmap          Json?     // { steps: [...], basedOn: [...] } — skills to learn next, from open drives
  roadmapUpdatedAt DateTime?
  resumeFeedback   Json?     // { strengths: string[], improvements: [...] }
  resumeFeedbackAt DateTime?

  applications  Application[]
  matches       DriveMatch[]
  notifications Notification[]
  escalation    Escalation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([program, branch])
}

model Recruiter {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName String
  companyDesc String?
  website     String?
  industry    String?

  // New recruiters wait for the TPO to approve them before they can create drives.
  status RecruiterStatus @default(PENDING)

  drives        Drive[]
  notifications RecruiterNotification[]

  createdAt DateTime @default(now())
}

model Drive {
  id          String      @id @default(cuid())
  recruiterId String
  recruiter   Recruiter   @relation(fields: [recruiterId], references: [id])

  companyName String
  jobRole     String
  jobDescriptionRaw String

  // AI-structured JD (from Gemma)
  jdRequiredSkills  String[] @default([])
  jdPreferredSkills String[] @default([])
  jdSummary         String?

  // Deterministic eligibility rules
  minCgpa        Float?
  maxBacklogs    Int?
  eligibleBranches String[] @default([])
  eligibleGradYears Int[]   @default([])

  driveDate   DateTime?
  venue       String?
  interviewStages String[] @default([])
  status      DriveStatus @default(DRAFT)
  // Optional last moment a student can apply or withdraw.
  applyDeadline DateTime?
  // When the placement cell last announced this drive to eligible students, and to how many.
  announcedAt    DateTime?
  announcedCount Int?

  applications Application[]
  interviews   Interview[]
  scheduleRequest ScheduleRequest?
  matches      DriveMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId])
  @@index([status])
}

/// A student's private AI fit check for a drive. It is NOT an application:
/// recruiters only see a student after they press Apply (see Application).
model DriveMatch {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  driveId   String
  drive     Drive   @relation(fields: [driveId], references: [id], onDelete: Cascade)

  fitScore         Int?
  matchedSkills    String[] @default([])
  missingSkills    String[] @default([])
  relevantProjects String[] @default([])
  matchExplanation String?

  updatedAt DateTime @updatedAt

  @@unique([studentId, driveId])
}

model Application {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  driveId   String
  drive     Drive             @relation(fields: [driveId], references: [id])

  stage ApplicationStage @default(ELIGIBLE)

  // TPO Special Consideration — lets a TPO surface a student to a recruiter
  // despite failing a rule-based eligibility check (e.g. low CGPA), when
  // their skills/projects justify a look. Never bypasses the recruiter's
  // own decision — only affects visibility, not stage/selection.
  specialConsideration     Boolean @default(false)
  specialConsiderationNote String?

  // Optional constructive note shown to the student on rejection — framed as
  // growth ("work on communication"), never as a dead-end failure.
  feedbackNote String?

  // AI matching output
  fitScore          Int?
  matchedSkills      String[] @default([])
  missingSkills      String[] @default([])
  relevantProjects   String[] @default([])
  matchExplanation   String?

  // Offer pipeline — stage (above) is the single source of truth for where
  // things stand; these are just the "when" for each step, for display.
  offerPackage      String? // set once, by the recruiter, when they request the offer
  offerMessage      String? // the recruiter's multi-line message to the candidate
  offerWithdrawnAt  DateTime?
  offerWithdrawnNote String? // why the recruiter withdrew the offer, shown to the student
  offerRequestedAt  DateTime?
  offerSentAt       DateTime?
  offerRespondedAt  DateTime?
  documentsVerified Boolean   @default(false)
  joined            Boolean   @default(false)
  joinedByRole      Role?     // who confirmed the joining (the placement cell or the recruiter)

  // Offer details. All optional or defaulted, so offers made before this existed keep working
  // (they show as Full-time, with their original offerPackage text).
  offerType               OfferType @default(FULL_TIME)
  offerCtcLpa             Float? // CTC as a number, in lakh per annum (Full-time and PPO)
  offerStipend            Int? // stipend in rupees per month (Internship)
  bondMonths              Int? // joining bond / service agreement length; empty = no bond
  bondNote                String? // bond details, e.g. the amount
  joiningDate             DateTime? @db.Date
  convertedFromInternship Boolean   @default(false)
  convertedAt             DateTime?

  // Joining-date deferral: the student asks, the placement cell decides.
  deferralStatus        DeferralStatus?
  deferralReason        String?
  deferralRequestedDate DateTime?       @db.Date
  deferralRequestedAt   DateTime?
  deferralDecidedAt     DateTime?
  deferralNote          String? // the placement cell's reason, shown to the student
  previousJoiningDate   DateTime?       @db.Date // the date before an approved deferral

  // In-app reminders (no email or SMS). Each timestamp stops the same reminder going out twice.
  documentsDueAt     DateTime?
  docReminderSentAt  DateTime?
  docOverdueSentAt   DateTime?
  offerFollowUpAt    DateTime?
  offerFollowUpCount Int       @default(0)

  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, driveId])
  @@index([driveId, stage])
  @@index([studentId])
}

model Interview {
  id            String   @id @default(cuid())
  driveId       String
  drive         Drive    @relation(fields: [driveId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  stage     String
  scheduledAt DateTime
  durationMins Int @default(30)
  venue     String?
  panel     String?

  hasConflict Boolean @default(false)
  conflictNote String?
  // The TPO knowingly scheduled this despite a clash (e.g. the recruiter can only come then).
  overridden     Boolean @default(false)
  overrideReason String?
  // Who set this slot up (the recruiter or the placement cell).
  scheduledByRole Role @default(TPO)

  createdAt DateTime @default(now())

  @@index([driveId])
  @@index([applicationId])
  @@index([scheduledAt])
}

model Notification {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([studentId, read])
}

/// Broadcast to every TPO at this college (there's typically just one, but
/// supports more). Single shared `read` flag is a deliberate simplification
/// for this single-college build, not a per-TPO read receipt.
model TpoNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model RecruiterNotification {
  id          String           @id @default(cuid())
  recruiterId String
  recruiter   Recruiter        @relation(fields: [recruiterId], references: [id])
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recruiterId, read])
}

/// The student's uploaded resume PDF, kept in its own table so list queries never
/// pull the file bytes. Viewable only via /api/resume/[studentId], which checks
/// who is asking (student: own, TPO: any, recruiter: only their drives' applicants).
model Resume {
  id         String   @id @default(cuid())
  studentId  String   @unique
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName   String
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now())
}

/// One per drive: the date, time window, venue and panels the recruiter and the placement cell agree on.
/// Interviews can only be booked inside the last agreed window.
model ScheduleRequest {
  id      String @id @default(cuid())
  driveId String @unique
  drive   Drive  @relation(fields: [driveId], references: [id])

  status ScheduleStatus @default(WAITING_TPO)

  // The proposal that is on the table right now.
  dates          String[] @default([]) // yyyy-mm-dd, up to 3 options
  startTime      String // HH:mm
  endTime        String // HH:mm
  panelCount     Int      @default(1)
  venue          String?
  panels         String? // one per line: "PANEL A @ ROOM 101"
  note           String?
  proposedByRole Role

  // The last agreed window. Bookings must fit inside it.
  agreedDates  String[] @default([])
  agreedStart  String?
  agreedEnd    String?
  agreedVenue  String?
  agreedPanels String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// The support list: students the rules flag as at risk of finishing the season unplaced.
/// The rules only flag; the placement cell picks the mentor. One row per student.
model Escalation {
  id         String           @id @default(cuid())
  studentId  String           @unique
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reasons    String[]         @default([]) // why the rules flagged them, in plain words
  status     EscalationStatus @default(OPEN)
  mentorName String?
  note       String?
  assignedAt DateTime?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
}
